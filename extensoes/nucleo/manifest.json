{
  "manifest_version": 3,
  "name": "Terra da Luz — Núcleo",
  "short_name": "Terra da Luz",
  "version": "1.0.0",
  "key": "",
  "description": "Proteção contra rastreadores e golpes, contêineres, modo Internet Explorer, central de extensões e nova aba do navegador Terra da Luz.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "downloads",
    "favicon",
    "management",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "topSites",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "paginas/novaaba.html"
  },
  "options_page": "paginas/painel.html",
  "action": {
    "default_title": "Terra da Luz",
    "default_popup": "paginas/popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rastreadores",
        "enabled": true,
        "path": "regras/rastreadores.json"
      },
      {
        "id": "parametros",
        "enabled": true,
        "path": "regras/parametros.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chromewebstore.google.com/*"
      ],
      "js": [
        "conteudo/loja.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}