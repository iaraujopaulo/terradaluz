{
  "_comentario": "Políticas do Terra da Luz. O instalador do Windows grava em HKLM\\SOFTWARE\\Policies\\Chromium; no Linux vão para /etc/chromium/policies/managed/. Os textos @...@ são preenchidos na compilação.",
  "MetricsReportingEnabled": false,
  "UrlKeyedAnonymizedDataCollectionEnabled": false,
  "SpellCheckServiceEnabled": false,
  "PasswordLeakDetectionEnabled": false,
  "PromotionalTabsEnabled": false,
  "BrowserSignin": 0,
  "BlockThirdPartyCookies": true,
  "DnsOverHttpsMode": "automatic",
  "DnsOverHttpsTemplates": "https://dns.quad9.net/dns-query",
  "ExtensionInstallSources": [
    "https://clients2.google.com/*",
    "https://clients2.googleusercontent.com/*",
    "https://chromewebstore.google.com/*",
    "@URL_PUBLICA@*"
  ],
  "ExtensionSettings": {
    "@ID_NUCLEO@": {
      "installation_mode": "force_installed",
      "update_url": "@URL_PUBLICA@extensoes/atualizacoes.xml",
      "toolbar_pin": "force_pinned"
    },
    "@ID_UBLOCK@": {
      "installation_mode": "force_installed",
      "update_url": "@URL_PUBLICA@extensoes/atualizacoes.xml",
      "toolbar_pin": "default_pinned"
    },
    "@ID_TEMA@": {
      "installation_mode": "normal_installed",
      "update_url": "@URL_PUBLICA@extensoes/atualizacoes.xml"
    }
  }
}
