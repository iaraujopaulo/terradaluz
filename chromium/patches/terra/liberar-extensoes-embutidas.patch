 // String to be prepended to each blocked entry.
 const char kBlockedExtensionPrefix[] = "[BLOCKED]";
+
+// Terra da Luz: o instalador grava políticas que instalam as extensões
+// embutidas do navegador a partir do servidor de atualizações do projeto.
+// Somente este endereço é liberado; qualquer outro continua bloqueado em
+// computadores domésticos (proteção contra programas maliciosos).
+const char kTerraDaLuzUpdateURLPrefix[] = "@TERRA_URL_ATUALIZACOES@";
+
+bool IsTerraDaLuzUpdateURL(const std::string& url) {
+  return base::StartsWith(url, kTerraDaLuzUpdateURLPrefix,
+                          base::CompareCase::INSENSITIVE_ASCII);
+}
